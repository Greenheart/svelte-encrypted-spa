{
    "name": "svelte-encrypted-spa",
    "author": "Samuel Plumppu",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build && node --env-file=.env scripts/postbuild.ts",
        "preview": "vite ./build --port 4173",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "fix": "prettier -l --write ."
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^26.6.6",
        "pagecrypt": "^7.1.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.4",
        "typescript": "^6.0.3",
        "vite": "^8.3.6"
    },
    "prettier": {
        "semi": false,
        "tabWidth": 4,
        "singleQuote": true,
        "plugins": [
            "prettier-plugin-svelte",
            "prettier-plugin-tailwindcss"
        ]
    },
    "engines": {
        "node": ">= 22"
    },
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
