{
    "name": "svelte-encrypted-spa",
    "author": "Samuel Plumppu",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build && node --env-file=.env scripts/postbuild.ts",
        "preview": "vite ./build --port 4173",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "prettier --check ."
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.3.0",
        "pagecrypt": "^7.1.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.2"
    },
    "prettier": {
        "semi": false,
        "tabWidth": 4,
        "singleQuote": true,
        "plugins": [
            "prettier-plugin-svelte",
            "prettier-plugin-tailwindcss"
        ]
    },
    "engines": {
        "node": ">= 22"
    },
    "type": "module"
}
